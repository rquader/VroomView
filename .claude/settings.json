{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(vercel env *)",
      "Bash(supabase *)",
      "Bash(gh secret *)",
      "Bash(npm install *)",
      "Bash(npm prune *)",
      "Bash(npm ci *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-access.sh\""
          }
        ]
      }
    ]
  },
  "disableBypassPermissionsMode": "disable"
}
