# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets.
# ".env*" ignores every env file; the "!" line then RE-ALLOWS the safe template.
.env*
!.env.example

# local-only E2E credentials (NOT matched by .env* — different prefix).
# Holds the rotated E2E test account login; never commit, never paste into chats.
.e2e.local
.e2e.*

# vercel (contains project linkage + a local OIDC token — keep out of git)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — keep shared project settings (.claude/settings.json),
# ignore personal/local overrides
.claude/settings.local.json
.visual-audit/
